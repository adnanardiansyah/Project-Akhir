rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function restaurantPath(restaurantId) {
      return /databases/$(database)/documents/restaurants/$(restaurantId);
    }

    function orderPath(orderId) {
      return /databases/$(database)/documents/orders/$(orderId);
    }

    function partnerApplicationPath(userId) {
      return /databases/$(database)/documents/partnerApplications/$(userId);
    }

    function isCustomer() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.role == 'customer';
    }

    function isAdmin() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.role == 'admin';
    }

    function isCourier() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.role == 'courier';
    }

    function isRestaurantOperator(restaurantId) {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.role == 'restaurant'
        && get(userPath(request.auth.uid)).data.restaurantId == restaurantId;
    }

    function isOrderCustomer(order) {
      return isCustomer() && order.customerUid == request.auth.uid;
    }

    function isOrderParticipant(order) {
      return isOrderCustomer(order)
        || isRestaurantOperator(order.restaurantId);
    }

    function isAssignedCourier(order) {
      return isCourier()
        && order.keys().hasAny(['assignedCourierUid'])
        && order.assignedCourierUid == request.auth.uid;
    }

    function canReadOrder(order) {
      return isAdmin()
        || isOrderParticipant(order)
        || isAssignedCourier(order);
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(fields);
    }

    function validAdminRestaurantReview() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isAdmin()
        && changed.hasOnly(['reviewStatus', 'reviewedBy', 'reviewedAt'])
        && changed.hasAll(['reviewStatus', 'reviewedBy', 'reviewedAt'])
        && request.resource.data.reviewStatus
          in ['pending', 'approved', 'rejected', 'suspended']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time;
    }

    function validCustomerProfile() {
      return request.resource.data.keys().hasAll(['role', 'displayName'])
        && request.resource.data.keys().hasOnly(['role', 'displayName'])
        && request.resource.data.role == 'customer'
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100;
    }

    function validPendingPartnerApplication(userId) {
      let data = request.resource.data;
      let profile = getAfter(userPath(userId)).data;
      return signedIn()
        && request.auth.uid == userId
        && existsAfter(userPath(userId))
        && profile.role == 'customer'
        && data.keys().hasAll([
          'applicantUid', 'applicationType', 'status', 'applicantName',
          'email', 'phone', 'createdAt'
        ])
        && data.keys().hasOnly([
          'applicantUid', 'applicationType', 'status', 'applicantName',
          'email', 'phone', 'createdAt', 'restaurantName', 'address',
          'location'
        ])
        && data.applicantUid == userId
        && data.applicantName == profile.displayName
        && data.email == request.auth.token.email
        && data.phone is string
        && data.phone.size() >= 9
        && data.phone.size() <= 25
        && data.status == 'pending'
        && data.createdAt == request.time
        && (
          (data.applicationType == 'restaurant'
            && data.keys().hasAll(['restaurantName', 'address', 'location'])
            && data.restaurantName is string
            && data.restaurantName.size() > 0
            && data.restaurantName.size() <= 120
            && data.address is string
            && data.address.size() > 0
            && data.address.size() <= 300
            && data.location is latlng)
          || (data.applicationType == 'courier'
            && !data.keys().hasAny(['restaurantName', 'address', 'location']))
        );
    }

    function validAdminPartnerApplicationReview() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isAdmin()
        && resource.data.status == 'pending'
        && changed.hasOnly([
          'status', 'reviewedBy', 'reviewedAt', 'rejectionReason'
        ])
        && changed.hasAll([
          'status', 'reviewedBy', 'reviewedAt', 'rejectionReason'
        ])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && (request.resource.data.status == 'approved'
          ? request.resource.data.rejectionReason == null
          : request.resource.data.rejectionReason is string
            && request.resource.data.rejectionReason.size() <= 300);
    }

    function validAdminPartnerRoleGrant(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let application = getAfter(partnerApplicationPath(userId)).data;
      return isAdmin()
        && resource.data.role == 'customer'
        && request.resource.data.displayName == resource.data.displayName
        && existsAfter(partnerApplicationPath(userId))
        && application.applicantUid == userId
        && application.applicantName == resource.data.displayName
        && application.status == 'approved'
        && application.reviewedBy == request.auth.uid
        && (
          (application.applicationType == 'courier'
            && request.resource.data.role == 'courier'
            && changed.hasOnly(['role']))
          || (application.applicationType == 'restaurant'
            && request.resource.data.role == 'restaurant'
            && request.resource.data.restaurantId == userId
            && changed.hasOnly(['role', 'restaurantId'])
            && existsAfter(restaurantPath(userId))
            && getAfter(restaurantPath(userId)).data.ownerUid == userId)
        );
    }

    function validPartnerRestaurantCreate(restaurantId) {
      let application = getAfter(partnerApplicationPath(restaurantId)).data;
      let data = request.resource.data;
      return isAdmin()
        && existsAfter(partnerApplicationPath(restaurantId))
        && application.applicationType == 'restaurant'
        && application.status == 'approved'
        && application.reviewedBy == request.auth.uid
        && data.keys().hasAll([
          'name', 'address', 'location', 'ownerUid', 'reviewStatus',
          'reviewedBy', 'reviewedAt'
        ])
        && data.keys().hasOnly([
          'name', 'address', 'location', 'ownerUid', 'reviewStatus',
          'reviewedBy', 'reviewedAt'
        ])
        && data.name == application.restaurantName
        && data.address == application.address
        && data.location == application.location
        && data.ownerUid == restaurantId
        && data.reviewStatus == 'pending'
        && data.reviewedBy == request.auth.uid
        && data.reviewedAt == request.time;
    }

    function validOrderCreate() {
      return isCustomer()
        && request.resource.data.keys().hasAll([
          'customerUid', 'customerName', 'restaurantId', 'restaurantName',
          'deliveryLocation',
          'items', 'total', 'status', 'paymentMethod', 'createdAt', 'paidAt'
        ])
        && request.resource.data.keys().hasOnly([
          'customerUid', 'customerName', 'restaurantId', 'restaurantName',
          'deliveryLocation',
          'items', 'total', 'status', 'paymentMethod', 'createdAt', 'paidAt'
        ])
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.customerName is string
        && request.resource.data.customerName
          == get(userPath(request.auth.uid)).data.displayName
        && request.resource.data.restaurantId is string
        && exists(restaurantPath(request.resource.data.restaurantId))
        && request.resource.data.restaurantName
          == get(restaurantPath(request.resource.data.restaurantId)).data.name
        && get(restaurantPath(request.resource.data.restaurantId))
          .data.reviewStatus == 'approved'
        && request.resource.data.deliveryLocation is latlng
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.total is int
        && request.resource.data.total >= 0
        && request.resource.data.status == 'pending'
        && request.resource.data.paymentMethod == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.paidAt == null;
    }

    function canConfirmOrder() {
      return isRestaurantOperator(resource.data.restaurantId)
        && resource.data.status == 'pending'
        && request.resource.data.status == 'confirmed'
        && changedOnly(['status']);
    }

    function canCancelOrder() {
      return (isOrderCustomer(resource.data)
          || isRestaurantOperator(resource.data.restaurantId))
        && resource.data.status in ['pending', 'confirmed']
        && request.resource.data.status == 'cancelled'
        && changedOnly(['status']);
    }

    function canPayOrder() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isOrderCustomer(resource.data)
        && resource.data.status == 'confirmed'
        && request.resource.data.status == 'paid'
        && request.resource.data.paymentMethod in ['ewallet', 'bankTransfer']
        && request.resource.data.paidAt == request.time
        && changed.hasOnly(['status', 'paymentMethod', 'paidAt'])
        && changed.hasAll(['status', 'paymentMethod', 'paidAt']);
    }

    function validCourierAssignment() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let courierUid = request.resource.data.assignedCourierUid;
      return isAdmin()
        && resource.data.status == 'paid'
        && (!resource.data.keys().hasAny(['deliveryStatus'])
          || resource.data.deliveryStatus == 'assigned')
        && changed.hasOnly([
          'assignedCourierUid', 'assignedCourierName',
          'deliveryStatus', 'assignedAt'
        ])
        && changed.hasAll([
          'assignedCourierUid', 'assignedCourierName',
          'deliveryStatus', 'assignedAt'
        ])
        && courierUid is string
        && exists(userPath(courierUid))
        && get(userPath(courierUid)).data.role == 'courier'
        && request.resource.data.assignedCourierName is string
        && request.resource.data.deliveryStatus == 'assigned'
        && request.resource.data.assignedAt == request.time;
    }

    function validCourierStart() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isAssignedCourier(resource.data)
        && resource.data.status == 'paid'
        && resource.data.deliveryStatus == 'assigned'
        && changed.hasOnly(['deliveryStatus', 'deliveryStartedAt'])
        && changed.hasAll(['deliveryStatus', 'deliveryStartedAt'])
        && request.resource.data.deliveryStatus == 'inTransit'
        && request.resource.data.deliveryStartedAt == request.time;
    }

    function validCourierLocationUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isAssignedCourier(resource.data)
        && resource.data.deliveryStatus == 'inTransit'
        && changed.hasOnly(['courierLocation', 'courierLocationUpdatedAt'])
        && changed.hasAll(['courierLocation', 'courierLocationUpdatedAt'])
        && request.resource.data.courierLocation is latlng
        && request.resource.data.courierLocationUpdatedAt == request.time;
    }

    function validCourierCompletion() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isAssignedCourier(resource.data)
        && resource.data.deliveryStatus == 'inTransit'
        && changed.hasOnly(['deliveryStatus', 'deliveredAt'])
        && changed.hasAll(['deliveryStatus', 'deliveredAt'])
        && request.resource.data.deliveryStatus == 'delivered'
        && request.resource.data.deliveredAt == request.time;
    }

    function canReadOrderId(orderId) {
      return exists(orderPath(orderId))
        && isOrderParticipant(get(orderPath(orderId)).data);
    }

    function validMessageCreate(orderId) {
      return exists(orderPath(orderId))
        && isOrderParticipant(get(orderPath(orderId)).data)
        && request.resource.data.keys().hasAll([
          'senderUid', 'senderRole', 'text', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'senderUid', 'senderRole', 'text', 'createdAt'
        ])
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time
        && (
          (request.resource.data.senderRole == 'customer'
            && isOrderCustomer(get(orderPath(orderId)).data))
          || (request.resource.data.senderRole == 'restaurant'
            && isRestaurantOperator(
              get(orderPath(orderId)).data.restaurantId
            ))
        );
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.auth.uid == userId
        && validCustomerProfile();
      allow update: if (signedIn()
        && request.auth.uid == userId
        && changedOnly(['displayName'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100)
        || validAdminPartnerRoleGrant(userId);
      allow delete: if false;
    }

    match /partnerApplications/{applicationId} {
      allow get: if isAdmin()
        || (signedIn() && request.auth.uid == applicationId);
      allow list: if isAdmin();
      allow create: if !exists(partnerApplicationPath(applicationId))
        && validPendingPartnerApplication(applicationId);
      allow update: if (isAdmin() && validAdminPartnerApplicationReview())
        || (isCustomer()
          && request.auth.uid == applicationId
          && resource.data.status == 'rejected'
          && request.resource.data.applicationType
            == resource.data.applicationType
          && validPendingPartnerApplication(applicationId));
      allow delete: if false;
    }

    match /restaurants/{restaurantId} {
      allow get, list: if isAdmin()
        || isRestaurantOperator(restaurantId)
        || (signedIn() && resource.data.reviewStatus == 'approved');
      allow create: if validPartnerRestaurantCreate(restaurantId);
      allow delete: if false;
      allow update: if validAdminRestaurantReview();

      match /menuItems/{menuItemId} {
        allow read: if isAdmin()
          || isRestaurantOperator(restaurantId)
          || (signedIn()
            && get(restaurantPath(restaurantId)).data.reviewStatus == 'approved');
        allow write: if false;
      }
    }

    match /orders/{orderId} {
      allow get, list: if canReadOrder(resource.data);
      allow create: if validOrderCreate();
      allow update: if canConfirmOrder()
        || canCancelOrder()
        || canPayOrder()
        || validCourierAssignment()
        || validCourierStart()
        || validCourierLocationUpdate()
        || validCourierCompletion();
      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if canReadOrderId(orderId);
        allow create: if signedIn() && validMessageCreate(orderId);
        allow update, delete: if false;
      }
    }
  }
}
